{
  "name": "dsh-mcp-global-manager",
  "version": "0.2.1",
  "description": "MCP 全局管理：扫描 28 个内置源与自定义源的 MCP 配置，把差异同步进 DSH，并在侧栏直接导入、同步回或增删改 MCP 服务器。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "model-context-protocol",
    "mcp-sync",
    "mcp-manager",
    "全局管理"
  ],
  "license": "MIT",
  "author": "asfre",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asfre/dsh-mcp-global-manager.git"
  },
  "homepage": "https://github.com/asfre/dsh-mcp-global-manager#readme",
  "bugs": {
    "url": "https://github.com/asfre/dsh-mcp-global-manager/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "CHANGELOG.md",
    "assets/screenshot-*.png"
  ],
  "scripts": {
    "scan": "node tools/cli-scan.mjs",
    "smoke": "node tools/smoke-client.mjs",
    "cold": "node tools/cold-start-check.mjs",
    "test": "node test/run.mjs"
  },
  "dependencies": {
    "js-yaml": "^4.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "engines": {
    "dsh": ">=0.1.0-rc.6 <0.3.0-0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
